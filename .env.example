# Optional: server-side deck storage on Vercel (Upstash Redis).
# In Vercel: Project → Storage → Create Database → Redis, or link from
# https://vercel.com/marketplace?category=storage&search=redis
# Then copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN into Project → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
